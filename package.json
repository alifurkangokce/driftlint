{
  "name": "@alifurkangokce/driftlint",
  "version": "0.2.0",
  "description": "Finds the claims in your CLAUDE.md / AGENTS.md / skills that your code no longer supports.",
  "type": "module",
  "bin": {
    "driftlint": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "npm run build && node --test \"test/*.test.js\""
  },
  "keywords": [
    "claude-code",
    "claude-md",
    "agents-md",
    "agent-skills",
    "lint",
    "documentation",
    "knowledge-decay",
    "ai-agents",
    "context-files"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alifurkangokce/driftlint.git"
  },
  "homepage": "https://github.com/alifurkangokce/driftlint#readme",
  "bugs": {
    "url": "https://github.com/alifurkangokce/driftlint/issues"
  },
  "author": "alifurkangokce",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
